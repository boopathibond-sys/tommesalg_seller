# Copy this file to `android/key.properties` and fill in your real values.
# This file (the .example) is safe to commit; key.properties itself is gitignored.
#
# storeFile can be an absolute path (with spaces allowed, no quotes) or a path
# relative to the android/app directory.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/your-upload-keystore.jks
