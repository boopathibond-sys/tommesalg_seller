# ── Vipps Login (OAuth2 / OpenID Connect) ─────────────────────────────
# Public client → PKCE only. `VIPPS_CLIENT_SECRET` is deliberately NOT
# in this file — the Flutter app never sees it. The secret stays in the
# Vipps Developer Portal and (eventually) a server-side .env on the
# Node.js backend. If you ever feel the need to paste it here, stop.
#
# Mobile redirect URI is hardcoded in lib/core/constants/vipps_constants.dart
# as `no.tommesalg.buyer:/vipps-callback`; register that same string in
# the Developer Portal. (The localhost URI in your portal config is for
# a future backend callback, not for this app.)
VIPPS_CLIENT_ID=78006d04-f89b-483a-a4cf-c4ecad059133
VIPPS_SUBSCRIPTION_KEY=443a53e92348721fd63a7afabd0e696b
VIPPS_ENVIRONMENT=test

# ── Stripe ────────────────────────────────────────────────────────────
# **Publishable key only.** The matching `sk_test_…` / `sk_live_…`
# secret key lives on the backend and is what creates the SetupIntent
# server-side. Putting the secret key here would ship it inside the
# APK/IPA, where any user can extract it in seconds.
#
# Stripe's own docs are explicit about this:
#   https://stripe.com/docs/keys#safe-keys
STRIPE_PUBLISHABLE_KEY=pk_test_51SeyljIitnpCTqxRX01CeSxuXAxqJbdeqoDwoB8Nmy8lnLD7xI68cavq9Xk2cRe0cvawRrY5dRVvh5k67sc6C1Q100gdbfv7Dl

