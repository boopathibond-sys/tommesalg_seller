# Shipped to the device as a Flutter asset, so treat everything in here as
# PUBLIC: assets sit unencrypted inside the IPA/APK and anyone can unzip and
# read them. Only values that are safe in a client binary belong here — a
# Supabase *anon* key (RLS-protected by design) and hostnames.
#
# Server-side credentials must never be added back. The Gemini, Bring, Vipps
# and Stripe keys that used to live here were unreferenced by any Dart code and
# were removed; anything like them belongs behind the backend.

# Seller REST API.
BASE_URL=https://tommesalg.no

# Buyer backend — hosts the account-deletion handoff and the anti-enumeration
# forgot-password endpoint.
BUYER_BASE_URL=

# Supabase auth (production). The anon key is public by contract.
SUPABASE_PROD_URL=https://cpivwcgsuhushcvfrwbq.supabase.co
SUPABASE_PROD_ANON_KEY=sb_publishable_uL95tnrZimBnf0p_fruUjw__mKnlSQh
