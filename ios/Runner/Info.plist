<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Seller Squad</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Password-recovery deep link:
	     tommesalgseller://auth/reset-password#access_token=…&refresh_token=…&type=recovery -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tommesalg.seller.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tommesalgseller</string>
			</array>
		</dict>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>nb</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>tommesalg_seller_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		Export compliance, answered here so it is baked into every upload.

		Without this key App Store Connect parks each build in "Missing
		Compliance" and it never enters the review queue until someone answers
		the encryption question by hand — silently costing a day per submission.

		`false` is correct as long as the app only uses encryption that is
		exempt under category 5 part 2: HTTPS/TLS to our own API, Supabase and
		Agora, plus Apple's own Keychain/crypto. Adding proprietary or
		non-standard cryptography later means flipping this to `true` and filing
		the CCATS/self-classification paperwork.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Seller Squad trenger tilgang til kameraet slik at du kan skanne strekkoder og sende live-video i auksjonsrommet.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Seller Squad trenger tilgang til mikrofonen slik at kjøperne kan høre deg under en live-auksjon.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Seller Squad trenger tilgang til bildene dine slik at du kan legge til produktbilder i annonsene dine.</string>
	<key>UIBackgroundModes</key>
	<array>
		<!--
			Lets APNs wake the app for `content-available: 1` pushes so a
			silent payload can be processed while backgrounded. Alert pushes
			do not need this — iOS draws those without waking us — but the
			backend may send data-only payloads.
		-->
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
